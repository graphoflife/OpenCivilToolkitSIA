# Arbeitsverzeichnis des Assistenten. Enthaelt hier einen fremden
# Git-Worktree (GraphOfLife) und gehoert nicht in dieses Projekt.
.claude/

__pycache__/
*.pyc
.venv/
test_env/
.idea/
build/
dist/
*.egg-info/
.pytest_cache/
ausgabe/
*.aux
*.log
*.out
*.synctex.gz
daten/

# Ist-Fassung eines abweichenden Berichts, zum Ansehen neben der Soll-Fassung.
tests/schnappschuss/*.ist

# Obsidian: die Einstellungen des Notizbuchs gehören dazu, seine
# Arbeitsdateien (Fenster, Plugins, Papierkorb) nicht.
notizbuch/.obsidian/*
!notizbuch/.obsidian/app.json
notizbuch/.trash/
